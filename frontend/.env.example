# Copy to .env.local for local development. On Vercel, set the same names in
# Project → Settings → Environment Variables.

# ── Database (required) ─────────────────────────────────────────────────
# Local:  the docker-compose Postgres below, or any Postgres you run.
# Vercel: a free Neon database (Vercel Marketplace → Neon) sets this for you.
# Tables are created by `npm run db:migrate`, which also runs on every build.
DATABASE_URL=postgresql://acceptify:acceptify@localhost:5432/acceptify

# ── Better Auth (required in production) ────────────────────────────────
# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it signs everyone out.
BETTER_AUTH_SECRET=

# The public URL of the site. Optional on Vercel (detected automatically);
# set it if you use a custom domain.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Extra origins allowed to call the auth endpoints, comma-separated —
# e.g. a custom domain. Vercel's own URLs are trusted automatically.
BETTER_AUTH_TRUSTED_ORIGINS=

# ── AI: Google Gemini (free tier) ───────────────────────────────────────
# Create a free key at https://aistudio.google.com/apikey
# Without it the essay reviewer and copilot report that AI is not set up.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.7-flash.
GEMINI_MODEL=
# Optional. "mock" returns canned placeholder answers for offline development.
AI_PROVIDER=

# ── Email delivery (password reset + email confirmation) ────────────────
# Free tier at https://resend.com (3,000 emails/month). Verify your sending
# domain, create an API key. Leave blank in local development: the reset link
# is printed in the terminal and shown on the forgot-password page.
RESEND_API_KEY=
EMAIL_FROM="Acceptify AI <no-reply@your-domain.com>"

# ── OAuth: Google ───────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
#   1. Create an OAuth client ID of type "Web application".
#   2. Authorized JavaScript origin:  http://localhost:3000
#   3. Authorized redirect URI:       http://localhost:3000/api/auth/callback/google
#      (repeat both with your production domain when you deploy)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth: Apple (optional, needs a paid Apple Developer account) ───────
# https://developer.apple.com/account/resources/identifiers
#   1. Register an App ID, enable the "Sign in with Apple" capability.
#   2. Register a Services ID (e.g. com.acceptify.web) — this is CLIENT_ID.
#      Return URL: https://<your-domain>/api/auth/callback/apple
#      Apple rejects localhost and plain http.
#   3. Create a "Sign in with Apple" key, download the AuthKey_XXXX.p8.
#   4. CLIENT_SECRET is an ES256 JWT signed with that key, valid 6 months max:
#        npm run apple:secret -- \
#          --team-id ABCDE12345 --key-id FGHIJ67890 \
#          --client-id com.acceptify.web --key-file ./AuthKey_FGHIJ67890.p8
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

# ── Admin access ────────────────────────────────────────────────────────
# Comma-separated addresses that may open /dashboard/admin and edit program
# weights. The account's email must be verified (Google sign-in counts).
# Empty means nobody is an admin.
ADMIN_EMAILS=
