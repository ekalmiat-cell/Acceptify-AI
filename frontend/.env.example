# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Database (shared with the FastAPI backend's Postgres instance) ────────
# Better Auth uses this connection to manage its own user/session/account
# tables. Same value as backend/.env's DATABASE_URL, just without the
# asyncpg driver prefix.
DATABASE_URL=postgresql://acceptify:acceptify@localhost:5432/acceptify

# ── Better Auth ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Email delivery (password reset links) ───────────────────────────────
# Sign up at https://resend.com, verify your sending domain, create an API
# key. Leave blank in local development: the reset link is printed in the
# terminal running `npm run dev` and shown on the forgot-password page.
RESEND_API_KEY=
EMAIL_FROM="Acceptify AI <no-reply@your-domain.com>"

# ── OAuth: Google ───────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
#   1. Create an OAuth client ID of type "Web application".
#   2. Authorized JavaScript origin:  http://localhost:3000
#   3. Authorized redirect URI:       http://localhost:3000/api/auth/callback/google
#      (repeat both with your production domain when you deploy)
# Leave these blank and the Google button is hidden instead of shown broken.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth: Apple ────────────────────────────────────────────────────────
# Requires a paid Apple Developer account.
# https://developer.apple.com/account/resources/identifiers
#   1. Register an App ID, enable the "Sign in with Apple" capability.
#   2. Register a Services ID (e.g. com.acceptify.web) — this is CLIENT_ID.
#      Domain: your production host. Return URL:
#        https://<your-domain>/api/auth/callback/apple
#      Apple rejects localhost and plain http, so use a tunnel (ngrok /
#      cloudflared) to test Apple locally.
#   3. Create a "Sign in with Apple" key, download the AuthKey_XXXX.p8.
#   4. CLIENT_SECRET is an ES256 JWT signed with that key, valid 6 months max:
#        npm run apple:secret --prefix frontend -- \
#          --team-id ABCDE12345 --key-id FGHIJ67890 \
#          --client-id com.acceptify.web --key-file ./AuthKey_FGHIJ67890.p8
#      Set a calendar reminder to regenerate it before it expires.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Only needed for a native iOS app signing in against this backend. Leave
# blank for a web-only setup.
APPLE_APP_BUNDLE_IDENTIFIER=
