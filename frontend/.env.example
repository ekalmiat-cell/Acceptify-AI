# ── App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Database (shared with the FastAPI backend's Postgres instance) ────────
# Better Auth uses this connection to manage its own user/session/account
# tables. Same value as backend/.env's DATABASE_URL, just without the
# asyncpg driver prefix.
DATABASE_URL=postgresql://acceptify:acceptify@localhost:5432/acceptify

# ── Better Auth ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── OAuth: Google ───────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── OAuth: Apple ────────────────────────────────────────────────────────
# https://developer.apple.com/account/resources/identifiers
# CLIENT_SECRET is a short-lived ES256 JWT you generate from your Apple
# private key — see https://www.better-auth.com/docs/authentication/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
