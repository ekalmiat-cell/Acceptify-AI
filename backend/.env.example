ENVIRONMENT=development

# SQLAlchemy async URL — same database as the frontend's DATABASE_URL, with
# the +asyncpg driver prefix.
DATABASE_URL=postgresql+asyncpg://acceptify:acceptify@localhost:5432/acceptify

# Better Auth's base URL (the Next.js app). Used both as the JWT issuer and
# to derive the JWKS endpoint: {AUTH_ISSUER}/api/auth/jwks
AUTH_ISSUER=http://localhost:3000

# Must match the `audience` set on the frontend's jwt() plugin — normally
# this backend's own public URL (NEXT_PUBLIC_API_URL on the frontend).
AUTH_AUDIENCE=http://localhost:8000

# Comma-separated allowed origins for CORS.
CORS_ORIGINS=http://localhost:3000

# Comma-separated addresses allowed to edit the program catalog and its
# evaluation weights (/dashboard/admin). Matched against the `email` claim on
# the Better Auth JWT. Must be kept in sync with the frontend's ADMIN_EMAILS.
# Empty means nobody is an admin and the catalog is read-only.
ADMIN_EMAILS=

# AI Essay Reviewer LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
LLM_TIMEOUT_SECONDS=35

